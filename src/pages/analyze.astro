---
import AnalyzerApp from '@/components/analyzer/AnalyzerApp';
import BaseLayout from '@/layouts/BaseLayout.astro';
const title = 'Android Bugreport Analyzer – DroidDiagnostics';
const description = 'Parse Android bugreport.zip locally for reboot, ANR, crash, kernel, Binder, memory, storage, biometric, display, thermal, battery, network, SELinux and boot evidence.';
---
<BaseLayout {title} {description}>
  <section class="content-page">
    <div class="shell">
      <header class="content-header">
        <span class="kicker">Free local diagnostic parser</span>
        <h1>Android Bugreport Analyzer</h1>
        <p>Drop the diagnostic archive below. DroidDiagnostics inventories the archive and runs deterministic subsystem analyzers inside a Web Worker. The source file is not uploaded and the parser does not depend on an LLM.</p>
      </header>
      <AnalyzerApp client:load />
    </div>
  </section>
</BaseLayout>
