---
import { errorReferences } from '@/content/errors';
import BaseLayout from '@/layouts/BaseLayout.astro';
export function getStaticPaths() { return errorReferences.map((entry) => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props;
---
<BaseLayout title={`${entry.title} – DroidDiagnostics`} description={entry.description}>
  <article class="content-page">
    <div class="shell">
      <header class="content-header"><span class="kicker">Error reference</span><h1>{entry.title}</h1><p>{entry.description}</p></header>
      <section class="card prose-card"><h2>Typical signature</h2><div class="callout"><code>{entry.signature}</code></div></section>
      <section class="card prose-card"><h2>What it means</h2><p>{entry.meaning}</p></section>
      <section class="card prose-card"><h2>Next checks</h2><ul>{entry.nextSteps.map((item) => <li>{item}</li>)}</ul></section>
      <a class="button button-primary" href="/analyze">Run local analysis</a>
    </div>
  </article>
</BaseLayout>
